# KORE App — Umgebungsvariablen
# Kopiere diese Datei nach .env und fülle die Werte aus.

# Database (SQLite)
DATABASE_URL="file:./data/kore.db"

# JWT Secrets (mindestens 32 Zeichen!)
JWT_SECRET="dein-jwt-secret-min-32-zeichen-hier"
JWT_REFRESH_SECRET="dein-refresh-secret-min-32-zeichen"

# Brevo SMTP — https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=dein-brevo-login@example.com
SMTP_PASS=dein-brevo-smtp-key

# E-Mails
NOTIFICATION_EMAIL=info@kore-retail.de
FROM_EMAIL=noreply@kore-retail.de

# Server
PORT=3001
NODE_ENV=production
